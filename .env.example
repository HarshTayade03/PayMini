# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
# NEVER commit real credentials, production secrets, or private keys to git.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=wallet_password_local_dev
POSTGRES_DB=wallet_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://wallet_user:wallet_password_local_dev@postgres:5432/wallet_db

# Backend App Configuration
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change_this_to_a_random_32_character_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business Rules / Safety Caps (Values in minor units: 100 paise = 1 INR)
STARTING_BALANCE_PAISE=50000        # ₹500.00 fake starter balance
TOPUP_MAX_PER_REQUEST_PAISE=100000  # ₹1,000.00 max single top-up
TOPUP_MAX_DAILY_PAISE=500000        # ₹5,000.00 max daily cumulative top-up
TRANSFER_MAX_PER_TX_PAISE=200000    # ₹2,000.00 max single transfer
DEFAULT_CURRENCY=INR

# Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Frontend & CORS
# In docker-compose or local dev, Next.js runs on port 3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PayMini Demo Wallet"
# Internal URL used by Next.js Server Components / Route Handlers to reach FastAPI
BACKEND_INTERNAL_URL=http://backend:8000
# Browser-facing API URL (for direct client fallbacks or API documentation)
NEXT_PUBLIC_API_URL=http://localhost:8000
